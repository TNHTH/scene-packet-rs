{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScenePacket",
  "version": "2.0.0",
  "identifier": "com.aivideoreader.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ScenePacket",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": false,
        "transparent": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
