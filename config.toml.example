# 复制为 <data-root>/config.toml；已存在的配置先比较，不直接覆盖。
# 留空工具路径会依次查找数据根 bin 和 PATH；手动配置使用绝对路径。
[extractor]
name = "ytdlp"
cookies_from_browser = "none"
cookies_file = ""
# 使用抖音 Cookie 时填导出浏览器的真实 User-Agent。
user_agent = ""

[asr]
default = "auto"
active_preset = "whisper-cpp-cpu" # NVIDIA 环境可选 whisper-cpp-cublas
model_path = "" # 默认 <data-root>/models/ggml-large-v3-turbo.bin
language = "zh"
prompt = "" # 可填写专业术语；不会自动改写识别结果
threads = 8
vad_model_path = "" # 可选 Silero VAD 模型绝对路径，要求 whisper.cpp 支持 --vad
vad_speech_pad_ms = 180
vad_min_silence_ms = 300
suppress_non_speech = false
no_fallback = false

[output]
cache_dir = "" # 留空用数据根 cache；相对路径以数据根为基准

[tools]
ffmpeg_path = ""
ffprobe_path = ""
ytdlp_path = ""
whisper_cli_path = ""
whisper_model_path = "" # 非空时优先于 asr.model_path

[ui]
enable_transparency = true
scene_threshold = 0.3
visual_hint_limit = 50
